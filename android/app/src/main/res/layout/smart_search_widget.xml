<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/smart_search_widget_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/smart_search_widget_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">

    <TextView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/smart_search_widget_mark"
        android:gravity="center"
        android:text="S"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Search contacts, apps, files"
        android:textColor="#E9EEF2"
        android:textSize="16sp" />

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/widget_search"
        android:src="@android:drawable/ic_menu_search"
        android:tint="#FFFFFF" />
</LinearLayout>
